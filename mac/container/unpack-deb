#!/usr/bin/python3
# unpack-deb DEB PREFIX DEST: the package's files under PREFIX (e.g. usr/share/novnc) to DEST,
# without installing it (the Dockerfile's noVNC: its package pulls in Node.js). Not dpkg-deb -x:
# its tar failed under QEMU's x86 emulation on an Apple Silicon Mac ("Cannot mkdir: Function not
# implemented" for every entry; tar uses a system call QEMU lacks). Python's tarfile (zstd since
# 3.14) does it with plain calls. A .deb is an ar archive; its files are in data.tar.*.
import io
import os
import sys
import tarfile


def ar_members(data):
    if data[:8] != b"!<arch>\n":
        sys.exit("not a .deb (ar archive)")
    pos = 8
    while pos + 60 <= len(data):
        head = data[pos:pos + 60]
        name = head[:16].decode().strip().rstrip("/")
        size = int(head[48:58].decode().strip())
        yield name, data[pos + 60:pos + 60 + size]
        pos += 60 + size + (size & 1)


def main(deb, prefix, dest):
    with open(deb, "rb") as f:
        data = f.read()
    tar = next((body for name, body in ar_members(data) if name.startswith("data.tar")), None)
    if tar is None:
        sys.exit("no data.tar in " + deb)
    prefix = prefix.strip("/") + "/"
    count = 0
    with tarfile.open(fileobj=io.BytesIO(tar), mode="r:*") as t:
        for m in t.getmembers():
            path = m.name[2:] if m.name.startswith("./") else m.name
            if not (path + "/").startswith(prefix) or path + "/" == prefix:
                continue
            m.name = path[len(prefix):]
            t.extract(m, dest, filter="data")
            count += 1
    if count == 0:
        sys.exit("nothing under %s in %s" % (prefix, deb))
    print("unpack-deb: %d entries of %s to %s" % (count, prefix, dest))


if __name__ == "__main__":
    if len(sys.argv) != 4:
        sys.exit("usage: unpack-deb DEB PREFIX DEST")
    os.makedirs(sys.argv[3], exist_ok=True)
    main(*sys.argv[1:])
