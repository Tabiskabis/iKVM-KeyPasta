#!/usr/bin/python3
# websockify, its web pages (noVNC) sent with "Cache-Control: no-cache": a browser asks again each
# time (304 if unchanged). Without it, browsers kept old noVNC files for weeks (they guess a time
# from the file dates): after the image's noVNC changed, an old ui.js with the new vnc.html broke
# the page ("Cannot read properties of null"). Same arguments as websockify.
# Each connection is handled in a process of its own (multiprocessing): forked, as before Python
# 3.14, whose default became "forkserver": that starts the child afresh from this file, which ran
# all of this again in it (a second websockify, "Address already in use"), and the browser got its
# connection reset, no page.
# keypasta.json (keypasta.js asks for it): the paste hotkeys in the agent's settings file
# (KEYPASTA_SETTINGS_DIR/agent.properties: pasteHotkey the default, pasteHotkey@host a host's),
# read at every request, so a hotkey changed in the viewer counts at the page's next load. The
# page can't know which BMC's viewer has the focus (IPMIView's desktop has several): it takes
# them all; the agent decides.
import json
import multiprocessing
import os
import sys
from http.server import SimpleHTTPRequestHandler
_end_headers = SimpleHTTPRequestHandler.end_headers
def end_headers(self):
    self.send_header('Cache-Control', 'no-cache')
    _end_headers(self)
SimpleHTTPRequestHandler.end_headers = end_headers


def hotkeys():
    keys = []
    path = os.path.join(os.environ.get('KEYPASTA_SETTINGS_DIR', '/keypasta-settings'), 'agent.properties')
    try:
        with open(path, encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if line.startswith(('#', '!')) or '=' not in line:
                    continue
                key, value = line.split('=', 1)
                if key.strip().replace('\\', '').split('@')[0] == 'pasteHotkey':
                    v = value.strip().replace('\\', '')
                    if v and v not in keys:
                        keys.append(v)
    except OSError:
        pass
    return keys or ['alt+shift+V']


_do_GET = SimpleHTTPRequestHandler.do_GET
def do_GET(self):
    if self.path.split('?')[0] == '/keypasta.json':
        body = json.dumps({'paste': hotkeys()}).encode()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        return
    _do_GET(self)
SimpleHTTPRequestHandler.do_GET = do_GET
from websockify.websocketproxy import websockify_init

if __name__ == '__main__':
    multiprocessing.set_start_method('fork')
    sys.argv[0] = 'websockify'
    sys.exit(websockify_init())
